{
  "name": "retro-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:pages": "wrangler pages dev dist --port 8788",
    "deploy": "npm run build && wrangler pages deploy dist --project-name retro-truelayer"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "jose": "^6.2.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "wrangler": "^4.167.0"
  },
  "allowScripts": {
    "workerd@1.20261123.1": true,
    "esbuild@0.28.2": true
  }
}
